# Application
APP_NAME="AI Novel Agent API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/novel_agent

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Security
SECRET_KEY=change-this-in-production-min-32-chars-long
API_KEY_HEADER=X-API-Key
ADMIN_API_KEY=
PERSONAL_USER_EMAIL=writer@local
PERSONAL_USER_NAME=Personal Writer

# LLM (Chat) - 支持 OpenAI 兼容 API（DeepSeek, 通义千问等）
LLM_API_KEY=your-chat-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
MAX_TOKENS=4096
TEMPERATURE=0.7

# Embedding - 可使用不同提供商，留空则复用 Chat 配置
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
